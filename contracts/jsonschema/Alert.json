{
  "$defs": {
    "AlertCategory": {
      "enum": [
        "SAFETY",
        "BATTERY",
        "DEADLOCK",
        "ROBOT",
        "ORDER",
        "STATION",
        "INVENTORY"
      ],
      "title": "AlertCategory",
      "type": "string"
    },
    "AlertSeverity": {
      "enum": [
        "INFO",
        "WARN",
        "CRITICAL"
      ],
      "title": "AlertSeverity",
      "type": "string"
    },
    "Coordinate": {
      "description": "2D grid coordinates (x East, y South).",
      "properties": {
        "x": {
          "description": "Column index (East)",
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Row index (South)",
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Coordinate",
      "type": "object"
    }
  },
  "properties": {
    "ext": {
      "additionalProperties": true,
      "description": "Extension dictionary for backward compatibility",
      "title": "Ext",
      "type": "object"
    },
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/AlertSeverity"
    },
    "category": {
      "$ref": "#/$defs/AlertCategory"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "entity_ids": {
      "items": {
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "cell": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coordinate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raised_tick": {
      "minimum": 0,
      "title": "Raised Tick",
      "type": "integer"
    },
    "resolved_tick": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Tick"
    },
    "requires_human": {
      "default": false,
      "title": "Requires Human",
      "type": "boolean"
    },
    "auto_resolved": {
      "default": true,
      "title": "Auto Resolved",
      "type": "boolean"
    }
  },
  "required": [
    "alert_id",
    "severity",
    "category",
    "message",
    "raised_tick"
  ],
  "title": "Alert",
  "type": "object"
}