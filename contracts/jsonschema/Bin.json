    },
    "quantity": {
      "default": 0,
      "minimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "capacity": {
      "default": 50,
      "minimum": 1,
      "title": "Capacity",
      "type": "integer"
    },
    "max_weight_g": {
      "default": 25000,
      "minimum": 1000,
      "title": "Max Weight G",
      "type": "integer"
    }
