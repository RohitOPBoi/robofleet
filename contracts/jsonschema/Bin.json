        "x": {
          "description": "Column index (East)",
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Row index (South)",
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Coordinate",
      "type": "object"
    }
  },
  "properties": {
